              "Data": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>STOA – New help request: please accept within 10 minutes</title>\n</head>\n<body style=\"margin:0;padding:0;background:#f4f2ef;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f2ef;padding:24px 12px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border-radius:12px;border:1px solid #e6e1da;\">\n<tr><td style=\"padding:28px 36px 8px;\">\n<img src=\"https://app.stoaedu.ch/email/stoa-logo.png\" width=\"132\" alt=\"STOA\" style=\"display:block;border:0;height:auto;\">\n</td></tr>\n<tr><td style=\"padding:16px 36px 0;font-family:Helvetica,Arial,sans-serif;color:#2b2523;\">\n<h1 style=\"margin:0 0 18px;font-size:22px;line-height:1.3;font-weight:700;color:#5c1620;\">A new help request for you</h1>\n<p style=\"margin:0 0 14px;font-size:16px;line-height:1.6;color:#2b2523;\">Hello,</p><p style=\"margin:0 0 14px;font-size:16px;line-height:1.6;color:#2b2523;\">A new help request has been offered to you.</p><p style=\"margin:0 0 14px;font-size:16px;line-height:1.6;color:#2b2523;\">Subject: Mathematics</p><p style=\"margin:0 0 14px;font-size:16px;line-height:1.6;color:#2b2523;\">Please accept it within 10 minutes; after that it is offered to another teacher.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:6px 0 22px;\"><tr><td style=\"border-radius:8px;background:#7a1f2b;\"><a href=\"https://app.stoaedu.ch/teacher/requests/req-687\" style=\"display:inline-block;padding:13px 26px;font-family:Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;\">Open the request in STOA</a></td></tr></table><p data-text-part